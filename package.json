{
  "name": "@jauza/core",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js",
      "require": "./dist/math/index.cjs"
    },
    "./position": {
      "types": "./dist/position/index.d.ts",
      "import": "./dist/position/index.js",
      "require": "./dist/position/index.cjs"
    },
    "./frames": {
      "types": "./dist/frames/index.d.ts",
      "import": "./dist/frames/index.js",
      "require": "./dist/frames/index.cjs"
    },
    "./transformations": {
      "types": "./dist/transformations/index.d.ts",
      "import": "./dist/transformations/index.js",
      "require": "./dist/transformations/index.cjs"
    },
    "./algos": {
      "types": "./dist/algos-contract.d.ts",
      "import": "./dist/algos-contract.js",
      "require": "./dist/algos-contract.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/math/index.ts src/position/index.ts src/frames/index.ts src/transformations/index.ts src/algos-contract.ts src/types.ts --format cjs,esm --dts --sourcemap",
    "dev": "tsup src/index.ts src/math/index.ts src/position/index.ts src/frames/index.ts src/transformations/index.ts src/algos-contract.ts src/types.ts --format cjs,esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "athdromeda",
  "license": "MIT",
  "description": "Jauza is a JavaScript/TypeScript library for Islamic astronomy calculations, including Hijri calendar conversions, Qibla direction, crescent moon observation, and prayer times.",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
